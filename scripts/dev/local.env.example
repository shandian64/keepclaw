# Source-installed OpenClaw local environment
# Copy to ~/.openclaw/local.env and fill in values for this machine.

# Codex workspaces
OPENCLAW_CODEX_WORKSPACE="$HOME/.openclaw/codex-workspace"
OPENCLAW_CODEX_SA_ROOT="/path/to/sa_final"
OPENCLAW_CODEX_JOBS_RUNTIME_DIR="$HOME/.openclaw/runtime/codex-sa-control"

# Local image generation
IMAGEGEN_SHARED_ROOT="/path/to/sa_final"
IMAGEGEN_TOOLS_ROOT="/path/to/sa_final/Tools"
IMAGEGEN_OUT_DIR="/path/to/sa_final/_patches/imagegen"
IMAGEGEN_IDLE_TIMEOUT_S="120"

# Wuyi image generation
WUYI_WORKSPACE="$HOME/.openclaw/wuyi-workspace"
WUYI_IMAGEGEN_OUT_DIR="$HOME/.openclaw/wuyi-workspace/outputs/imagegen"

# Windows browser control from WSL
OPENCLAW_WINDOWS_CHROME_PATH="/mnt/c/Program Files/Google/Chrome/Application/chrome.exe"
OPENCLAW_WINDOWS_EDGE_PATH="/mnt/c/Program Files (x86)/Microsoft/Edge/Application/msedge.exe"
OPENCLAW_WINDOWS_BROWSER_PROFILE_ROOT="$HOME/.openclaw/browser-profiles"

# Optional third-party tools
# TAVILY_API_KEY="..."
